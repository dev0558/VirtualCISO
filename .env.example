# Copy to .env and replace every value. Never commit .env.
ENV=development
POSTGRES_PASSWORD=replace-with-strong-password
APP_DB_PASSWORD=replace-with-another-strong-password
SECRET_KEY=replace-with-64-random-characters-python-c-import-secrets-print-secrets-token-urlsafe-48
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=
S3_ACCESS_KEY=vciso-evidence
S3_SECRET_KEY=replace-with-strong-password
# Optional: enables AI drafting/answers. Without a key, template + retrieval fallbacks are used.
# AI_PROVIDER: anthropic | gemini
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Real client data needs a key on a billed Cloud project: Google's unpaid tier may use prompts to
# improve its products and lets human reviewers read them.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PUBLIC_APP_URL=http://localhost:3000
COOKIE_SECURE=false
# Password for the fictional demo users created by `make seed` (12+ chars)
# Public demo: API refuses all changes and AI calls. Pair with NEXT_PUBLIC_DEMO_MODE=1 on the web app.
DEMO_READ_ONLY=false
DEMO_PASSWORD=
